# ==============================================
# STUDAICOACH - ENVIRONMENT CONFIGURATION
# ==============================================

# ==============================================
# APPLICATION SETTINGS
# ==============================================
NODE_ENV=development
APP_NAME=StudAICoach
APP_URL=https://studaicoach.com

# ==============================================
# SERVER PORTS
# ==============================================
# Backend API Port
API_PORT=3000

# Frontend Port
FRONTEND_PORT=3001

# Admin Dashboard Port
ADMIN_DASHBOARD_PORT=3002

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# MySQL Database
DATABASE_URL="mysql://user:password@localhost:3306/studaicoach"
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=studaicoach_user
DB_PASSWORD=your_secure_password_here
DB_NAME=studaicoach

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ==============================================
# AUTHENTICATION & SECURITY
# ==============================================
# JWT Secrets
JWT_SECRET=your_jwt_secret_key_min_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth2 - Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/oauth/google/callback

# OAuth2 - Microsoft
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/auth/oauth/microsoft/callback

# API Key Encryption
API_KEY_ENCRYPTION_SECRET=your_api_key_encryption_secret_min_32_chars

# ==============================================
# AI & ML SERVICES
# ==============================================
# OpenAI
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_ORG_ID=org-your_openai_org_id
OPENAI_MODEL_GPT4=gpt-4
OPENAI_MODEL_GPT4_MINI=gpt-4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
GEMINI_MODEL=gemini-pro

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-sonnet-20240229

# Default AI Provider (openai | gemini | claude)
DEFAULT_AI_PROVIDER=openai

# Multi-Modal AI Configuration
ENABLE_MULTIMODAL=true
MULTIMODAL_PROVIDERS=openai,gemini  # comma-separated list

# ==============================================
# OCR SERVICES
# ==============================================
# Google Cloud Vision API
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id
GOOGLE_CLOUD_VISION_API_KEY=your_google_vision_api_key
GOOGLE_APPLICATION_CREDENTIALS=./config/gcp-credentials.json

# AWS Textract (Fallback)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# OCR Provider Priority (google | aws)
OCR_PRIMARY_PROVIDER=google
OCR_FALLBACK_PROVIDER=aws

# ==============================================
# VECTOR DATABASE
# ==============================================
# Pinecone
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=us-east1-gcp
PINECONE_INDEX_NAME=studaicoach-rubrics

# ==============================================
# FILE STORAGE
# ==============================================
# Cloud Storage Provider (s3 | gcs)
STORAGE_PROVIDER=s3

# AWS S3
AWS_S3_BUCKET=studaicoach-uploads
AWS_S3_REGION=us-east-1

# Google Cloud Storage
GCS_BUCKET=studaicoach-uploads
GCS_PROJECT_ID=your_gcp_project_id

# File Upload Limits
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf

# ==============================================
# PAYMENT GATEWAY
# ==============================================
# Stripe
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Razorpay (Alternative)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ==============================================
# EMAIL SERVICE
# ==============================================
# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password

# SendGrid (Alternative)
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@studaicoach.com
FROM_NAME=StudAICoach

# ==============================================
# MONITORING & LOGGING
# ==============================================
# Sentry
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development

# Log Level (error | warn | info | debug)
LOG_LEVEL=debug

# ==============================================
# RATE LIMITING
# ==============================================
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================
# MULTI-TENANCY & SUBDOMAINS
# ==============================================
# Base Domain
BASE_DOMAIN=studaicoach.com

# Subdomain Strategy (subdomain | path)
TENANT_STRATEGY=subdomain

# Individual User URL Pattern (linkedin-style)
USER_URL_PATTERN=/in/{username}

# ==============================================
# FEATURE FLAGS
# ==============================================
ENABLE_AUTO_CORRECTION=true
ENABLE_QUESTION_GENERATION=true
ENABLE_FEEDBACK_SYSTEM=true
ENABLE_EFFECTIVENESS_EVALUATION=true
ENABLE_GAMIFICATION=true
ENABLE_CHATBOT=true

# ==============================================
# AI TOKEN OPTIMIZATION
# ==============================================
# Token Limits
FREE_TIER_MONTHLY_UPLOADS=5
FREE_TIER_MONTHLY_CHAT_QUERIES=20
PREMIUM_INDIVIDUAL_MONTHLY_CHAT_QUERIES=200

# Token Cost Tracking
ENABLE_TOKEN_TRACKING=true
ENABLE_TOKEN_POOLING=true

# ==============================================
# EFFECTIVENESS EVALUATION AGENT
# ==============================================
# Evaluation Frequency (cron format: weekly = 0 0 * * 0)
EFFECTIVENESS_EVAL_CRON=0 0 * * 0  # Every Sunday at midnight
EFFECTIVENESS_EVAL_ENABLED=true

# ==============================================
# CORS & SECURITY
# ==============================================
CORS_ORIGIN=http://localhost:3001,http://localhost:3002
CORS_CREDENTIALS=true

# ==============================================
# QUEUE CONFIGURATION
# ==============================================
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY_MS=5000

# ==============================================
# DEVELOPMENT ONLY
# ==============================================
DEBUG_MODE=true
ENABLE_API_DOCS=true
SWAGGER_PATH=/api/docs
